# Puerto del servidor HTTP
PORT=3000

# Lista de orígenes permitidos para CORS, separados por comas.
# Déjalo vacío si no necesitas restringir orígenes explícitamente.
ALLOWED_ORIGINS=

# Máximo de solicitudes por ventana de 15 minutos en /api
RATE_LIMIT_MAX=300

# Número de proxies de confianza cuando ejecutas detrás de reverse proxy.
# Usa 1 si estás detrás de Nginx/Render/Fly/etc.
TRUST_PROXY=0

# Credenciales para habilitar Basic Auth en la API.
# Si defines BASIC_AUTH_USER y BASIC_AUTH_PASSWORD, la API quedará protegida.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me

# PIN alternativo opcional para acceder desde el panel web.
BASIC_AUTH_PIN=1234

# Ruta opcional a la base SQLite.
# Si se omite, la app usa ./finance.db en la raíz del proyecto.
# Puede ser relativa al proyecto o absoluta.
DATABASE_PATH=finance.db
