{
  "name": "control-finanzas",
  "version": "1.0.0",
  "type": "module",
  "description": "Aplicación web para controlar gastos, ingresos y suscripciones en pesos chilenos",
  "main": "finance-server.js",
  "scripts": {
    "start": "node finance-server.js",
    "test": "vitest run --maxWorkers=1",
    "test:ci": "vitest run --maxWorkers=1",
    "test:unit": "vitest run src/__tests__/escapeHtml.test.js src/__tests__/helpers.test.js src/__tests__/transactionRepository.test.js",
    "test:integration": "vitest run --maxWorkers=1 src/__tests__/*-api.test.js src/__tests__/health-auth.test.js",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/ui": "^1.6.0",
    "vitest": "^1.6.0"
  }
}
